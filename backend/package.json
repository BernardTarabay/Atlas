{
  "name": "backend",
  "version": "1.0.0",
  "description": "Document Management & Intelligent File Organization Platform - API",
  "main": "src/server.js",
  "scripts": {
    "dev": "node scripts/preflight-dev.js && nodemon src/server.js",
    "dev:only": "nodemon src/server.js",
    "start": "node src/server.js",
    "worker": "node src/workers/runner.js",
    "worker:dev": "nodemon src/workers/runner.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset-data": "node src/db/resetData.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "verify:agent": "node scripts/verify-agent-e2e.js",
    "verify:all": "node scripts/verify-all.js",
    "test:watch": "node --test --watch \"tests/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pdfjs-dist": "^4.10.38",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "nodemonConfig": {
    "ignore": [
      "storage/**",
      "*.log",
      "tmp/**",
      ".git/**"
    ],
    "ext": "js,mjs,cjs,json"
  }
}
