{
  "name": "atlas",
  "version": "2.0.0-dev",
  "private": true,
  "type": "module",
  "description": "Atlas V2: a local, fast, recoverable file organization engine",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/main.ts",
    "build:native": "node --disable-warning=ExperimentalWarning scripts/build-native.ts",
    "intent": "node --disable-warning=ExperimentalWarning scripts/intent.ts",
    "db": "node --disable-warning=ExperimentalWarning scripts/db.ts",
    "apply": "node --disable-warning=ExperimentalWarning scripts/apply.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "bench:gen": "node --disable-warning=ExperimentalWarning bench/gen.ts",
    "bench": "node --disable-warning=ExperimentalWarning bench/run.ts",
    "bench:scan": "node --disable-warning=ExperimentalWarning bench/scan.ts",
    "bench:apply-crash": "node --disable-warning=ExperimentalWarning bench/apply-crash.ts",
    "bench:crash": "node --disable-warning=ExperimentalWarning bench/crash.ts",
    "bench:ocr:corpus": "node --disable-warning=ExperimentalWarning bench/ocr-corpus.ts",
    "bench:ocr": "node --disable-warning=ExperimentalWarning bench/ocr-bench.ts",
    "bench:rvl": "node --disable-warning=ExperimentalWarning bench/rvl-bench.ts",
    "bench:robust": "node --disable-warning=ExperimentalWarning bench/robust-bench.ts"
  },
  "dependencies": {
    "exifr": "7.1.3",
    "pdfjs-dist": "4.10.38"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^7.0.2"
  }
}
