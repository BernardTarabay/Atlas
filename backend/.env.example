# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:abdosql@localhost:5432/document_management
PGSSL=false

# JWT
#
# These are SIGNING KEYS: anyone who knows one can mint a session for any
# account. The server refuses to start while they still say "change-me"
# (config/env.js), and in production it also refuses anything under 32
# characters. Generate each one separately:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Job queue (Phase 7; moved off Redis in migration 040).
#
# There is no REDIS_URL any more, and no Redis to install. The queue lives in
# `processing_jobs` in the database above -- see docs/06-processing-pipeline.md.
# WORKER_CONCURRENCY is the number of lanes per pool; the worker runs two pools
# so that slow stages (describe, ocr) cannot starve fast ones.
WORKER_CONCURRENCY=4

# Desktop agent auth (Phase 12). A third, DIFFERENT random value -- an agent
# token and a user token must never be interchangeable.
AGENT_JWT_SECRET=change-me-agent-secret

# AI classification escalation tier (docs/09-ai-classification.md).
# Leave GEMINI_API_KEY unset to keep this feature entirely off -- the
# rule-based classifier is unaffected either way. Get a key at
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Model for the Subjects-page chatbot (organize-by-conversation). Defaults
# to GEMINI_MODEL above if unset -- only set this if you want the chatbot on
# a different model than file classification.
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# Set to "false" to disable even if a key is present, without removing it.
AI_CLASSIFICATION_ENABLED=true
# Only escalate to the LLM when the rule-based result's confidence is below
# this level: "high" = escalate low/medium rule-based matches only (a clean
# keyword match on "high" is trusted as-is); "medium" = escalate low only
# (fewer calls, not more -- a "medium" floor means only results below medium
# qualify); "always" = escalate every file regardless of rule-based
# confidence, so Gemini acts as a second-opinion check even on matches the
# rule-based pass was already confident about. generateNamesProcessor always
# proposes a rename from the most recent classification_results row, so if
# Gemini disagrees with (or is less confident than) a "high" rule-based
# match under "always", that disagreement correctly holds the rename back.
# Note "always" means every scanned file gets a Gemini call, and there is
# no daily call cap -- see the note in src/config/env.js for why the previous
# one was removed rather than re-tuned.
AI_ESCALATE_BELOW_CONFIDENCE=always
# How long to wait on a single Gemini call before giving up on it.
AI_REQUEST_TIMEOUT_MS=20000

# THERE IS NO ARTIFICIAL AI CAP IN THIS APPLICATION.
#
# Two used to exist and both are gone: AI_DAILY_CALL_CAP (a rolling 24h
# ceiling) and a default 12 req/min client-side pace. Each was this
# application inventing a limit and then failing its own work against it --
# the daily cap alone stranded 5,730 files in one night.
#
# The real quota belongs to Google and Google enforces it: a 429 comes back
# carrying "Please retry in 25.054123681s", and every AI caller here honours
# that hint and retries (services/ai/rateLimiter.js). That is backpressure
# measured against the actual limit instead of a guess at it.
#
# Spend stays VISIBLE rather than restricted -- every billed call is written
# to the audit log (BILLED_AI_ACTIONS in services/descriptionService.js), so
# cost is reported, not refused. `node scripts/measure-ai-cost.js` summarises
# it.
#
# Leave this at 0 (or unset) for no throttle. Set a positive number only to
# opt back into client-side pacing on a deliberately constrained key.
GEMINI_RATE_LIMIT_PER_MINUTE=0

# Descriptions and description search (docs/06-processing-pipeline.md 6.8).
# Every file gets a plain-language description of what it IS, and that
# description is embedded so the file can be found by describing it from
# memory -- including photos, video and audio, which have no text at all.
#
# The embedding model. 768 dimensions are requested rather than its full
# 3072: the search cache holds every vector in memory, and the quality
# difference is under a point on Google's own benchmarks.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Ceiling on a video or audio file that will be described. Video is billed by
# DURATION, not size -- the API samples frames -- so a long recording is
# expensive to describe. Anything above this gets a facts-only description
# instead. Files over ~14MB are uploaded via the Files API automatically.
AI_MEDIA_MAX_BYTES=209715200
# How close a description must be to what you typed to count as a match.
# This model's floor is high: two unrelated texts still score ~0.55, a good
# match ~0.81, and an English query against a French description ~0.72.
# Raise it for stricter results, lower it if searches come back empty.
DESCRIPTION_SEARCH_MIN_SIMILARITY=0.62

# File Preview thumbnails (Files page Preview button / Edit modal).
# Real images are shown as-is; every other format (docx/xlsx/pptx/pdf/
# legacy office/txt/csv/svg/etc.) is rendered to a picture of its first
# page via LibreOffice headless, which must be installed on this machine
# and reachable as "soffice" on PATH (or one of the common default
# install locations, checked automatically). Without it, previews for
# non-image files fall back to the extracted-text excerpt instead of an
# image -- nothing breaks, it just won't be a picture.
# Where generated thumbnails are cached on disk (created automatically).
THUMBNAIL_CACHE_DIR=./storage/thumbnails
# Where the frontend dev server runs -- only used to build the final
# browser redirect after an OAuth callback finishes (see email section
# below). The default matches `npm run dev` in frontend/.
FRONTEND_URL=http://localhost:5173

# Email Inbox (Subjects-adjacent "Inbox" page: connect Gmail/Outlook, auto-
# triage junk, surface what's left). See docs/10-email-inbox.md.
#
# 1) Generate a random key and set it below -- required before connecting
#    any account (encrypts the stored OAuth refresh token). Any non-empty
#    string works; longer/more random is better.
#    Generate one with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-value

# 2) Gmail -- create an OAuth 2.0 Client ID in Google Cloud Console
#    (console.cloud.google.com -> APIs & Services -> Credentials -> Create
#    Credentials -> OAuth client ID -> Web application). Add
#    GOOGLE_OAUTH_REDIRECT_URI below as an "Authorized redirect URI" on
#    that client. Enable the Gmail API for the project. For personal use,
#    leave the OAuth consent screen in "Testing" mode and add your own
#    Google account as a test user -- this avoids Google's app-verification
#    review entirely, which otherwise only matters for apps used by people
#    outside your own test-user list.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5000/api/email-accounts/oauth/gmail/callback

# Outlook / Microsoft 365 support was REMOVED. Gmail is the only email
# provider. Any MICROSOFT_OAUTH_* values you still have set are ignored
# by the application and can be deleted.

# How often connected accounts auto-sync in the background, in addition to
# the manual "Sync now" button.
EMAIL_SYNC_INTERVAL_MINUTES=15

# ---------------------------------------------------------------------------
# Organized shortcut mirror, real-time watching, auto-apply
# ---------------------------------------------------------------------------
# Where the organized folder tree of SHORTCUTS is built. Every entry points
# at the real file wherever it lives -- nothing is copied or moved, so this
# folder is disposable and rebuilt by the sync_mirror job. Unset it and the
# mirror simply isn't built.
MIRROR_ROOT=

# Real-time ingestion: notice new/changed files without pressing "Run scan".
WATCH_ENABLED=true
# Wait for writes to settle before ingesting (a file being copied in fires
# many events and is incomplete until the last one).
WATCH_DEBOUNCE_MS=4000
# Safety net for events missed while asleep or with a drive unplugged.
WATCH_RESCAN_INTERVAL_MINUTES=60

# Minimum classifier confidence for a name to be applied without review.
# Only consulted for locations with auto_apply_naming enabled, and refused
# outright on writable locations (it would rename real files unattended).
AUTO_APPLY_MIN_CONFIDENCE=high

# ---------------------------------------------------------------------------
# Folder picker scope (GET /api/storage-locations/browse)
# ---------------------------------------------------------------------------
# The picker lets you click through this machine's folders to register a
# storage location instead of typing an absolute path.
#
# UNSET (the default) = no confinement. The picker sees every mounted drive,
# which is what you want when this is your own desktop: C:\, D:\, an external
# disk, a NAS mount. This is the normal setup for this application.
#
# Set it ONLY if more than one person has an account on this server. An
# unconfined picker lets any account enumerate the whole filesystem, including
# other accounts' home directories -- nothing about a bare directory listing
# can be scoped per-user, so confinement is the only control. The server logs
# a warning at startup if a second account exists and this is still unset.
#
# Separate multiple roots with ';' on Windows, ':' elsewhere.
#
#   BROWSE_ROOTS=C:\Users\me;E:\Archive
